{
  "$schema": "https://opencode.ai/v2/cli.json",
  "tabs": {
    "mode": "on",
    "scope": "global",
    "layout": "horizontal",
    "indicators": "status"
  },
  "attention": {
    "notifications": true,
    "sound": true,
    "volume": 0.7
  },
  "mini": {
    "thinking": "show",
    "tools": "show",
    "shell_output": "show",
    "turn_summary": "show",
    "footer": "show",
    "splash": "show",
    "work_spinner": "block-soft-slide",
    "mono": false,
    "replay": true,
    "replay_limit": 200
  },
  "theme": {
    "name": "system"
  },
  "session": {
    "thinking": "show",
    "markdown": "rendered",
    "grouping": "auto",
    "image_preview": false,
    "permissions": "prompt"
  },
  "diffs": {
    "view": "auto"
  },
  "debug": {
    "devtools": false
  }
}
